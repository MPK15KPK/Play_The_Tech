# Azure Postgres — sslmode=require is mandatory
DATABASE_URL=postgres://USER:PASSWORD@YOURSERVER.postgres.database.azure.com:5432/playthetech?sslmode=require

# The only credentials that exist. No user table, no signup.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=use-a-long-random-string

# Signs the login cookie. Changing it logs you out.
SESSION_SECRET=another-long-random-string

# Canonical URLs and sitemap. No trailing slash.
SITE_URL=https://playthetech.com

# ---------------------------------------------------------------------------
# Alternative to DATABASE_URL: supply the parts and lib/db.js assembles the URL
# with sslmode=require. Set either DATABASE_URL or all five of these.
#
# POSTGRES_HOST=yourserver.postgres.database.azure.com
# POSTGRES_PORT=5432
# POSTGRES_DATABASE=playthetech
# POSTGRES_USER=youruser
# POSTGRES_PASSWORD=yourpassword
